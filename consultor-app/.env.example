# Copia este archivo como .env.local y pega los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API / Data API).
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave "publishable" (o "anon public"). NUNCA pongas aquí la "secret" / "service_role".
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
